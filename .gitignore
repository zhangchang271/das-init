# Scientific inputs and generated products stay outside version control.
/data/
# One preprocessed segment is bundled so the 50-channel demo runs from clone.
!/data/
/data/*
!/data/demo_sanjose_50ch/
/data/demo_sanjose_50ch/*
!/data/demo_sanjose_50ch/segments/
/data/demo_sanjose_50ch/segments/*
/demo_data/
/demo_data_sanjose/
/outputs/
/cache/
/logs/
*.h5
*.hdf5
*.mat
!/docs/demo/result.mat
!/docs/demo/checkpoints.mat
# Small DASQt-preprocessed input for the runnable San Jose demo.
!/data/demo_sanjose_50ch/segments/*.mat
*.npy
*.npz
*.bin
*.sgy
*.segy
*.tdms
*.xlsx
*.log
*.zip
*.tar
*.tar.gz
# Machine-specific configuration and environments.
/configs/*.local.json
/configs/sj_run.json
/configs/sj_run_32w.json
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.DS_Store
*.asv
.env
.env.*
*.pem
*.key
